# ============================================================
# CRM - Backend (server) - Variables de entorno
# Copiar a server/.env y completar. NUNCA subir .env al repositorio.
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=4000
# Poner en true solo detrás de un reverse proxy (nginx, IIS) para que
# express-rate-limit y las cookies Secure lean la IP/protocolo reales.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Base de datos (SQL Server via Prisma) ---
# Desarrollo local con autenticación integrada de Windows (sin contraseña):
DATABASE_URL="sqlserver://localhost:1433;database=crm_dev;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
# Alternativa con login SQL (modo mixto):
# DATABASE_URL="sqlserver://localhost:1433;database=crm_dev;user=crm_app;password=CAMBIAR;encrypt=true;trustServerCertificate=true"
# Base de datos usada por los tests de integración (se limpia en cada corrida):
TEST_DATABASE_URL="sqlserver://localhost:1433;database=crm_test;integratedSecurity=true;encrypt=true;trustServerCertificate=true"

# --- Autenticación ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# En producción debe ser true (requiere HTTPS)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- CORS (orígenes permitidos separados por coma) ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Seed (solo se usa al ejecutar `npm run db:seed`) ---
# El administrador inicial deberá cambiar esta contraseña en el primer login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Sistema
