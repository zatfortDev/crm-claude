# ============================================================
# CRM - Frontend (client) - Variables de entorno
# Copiar a client/.env. Solo se exponen variables con prefijo VITE_.
# NUNCA colocar secretos aquí: todo lo que empieza con VITE_ se
# incluye en el bundle público del navegador.
# ============================================================
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=CRM
